<Page x:Class="omni_multitool.Features.WaterReminder.WaterReminderPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:omni_multitool.Features.WaterReminder"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="WaterReminder">

    <Grid>

        <StackPanel Margin="30">

            <!--Utilities Section-->

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                    Style="{StaticResource IconStyle}">

                    <TextBlock
                FontFamily="{StaticResource MaterialSymbolsOutlined}"
                Text="&#xE869;"
                FontSize="22"
                FontWeight="Thin"
                Foreground="#FEFEFE"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"/>

                </Border>

                <StackPanel Grid.Column="1"
                Orientation="Horizontal"
                VerticalAlignment="Center"
                Margin="20,0,0,0">
                    <TextBlock
                    Text="Utilities"
                    Margin="0,4,0,0"
                    Style="{StaticResource SettingsSectionHeader}"/>

                    <TextBlock
                    Text=" / "
                    Margin="0,4,0,0"
                    Style="{StaticResource SettingsSectionHeader}"
                    Foreground="#666666"/>

                    <TextBlock
                    Text="Water Reminder"
                    Margin="0,4,0,0"
                    Style="{StaticResource SettingsSectionHeader}"/>

                </StackPanel>
            </Grid>

            <Border Height="1"
                Background="#444444"
                Margin="0,20,0,20"/>



            <TextBlock Text="Water Reminder"
               FontSize="22"
               FontWeight="Medium"
               Foreground="#C94FF8"
               HorizontalAlignment="Left"
               Margin="10,6,0,0"/>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>


                <ToggleButton
            Style="{StaticResource ToggleStyle}"
            Margin="10"
            Grid.Column="0"/>

                <TextBlock Text="Disabled"
               FontSize="16"
               Grid.Column="1"
               Foreground="#C8C8C8"
               VerticalAlignment="Center"/>
            </Grid>
        </StackPanel>
    </Grid>
</Page>
