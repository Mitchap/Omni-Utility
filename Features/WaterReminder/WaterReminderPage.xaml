<Page x:Class="omni_multitool.Features.WaterReminder.WaterReminderPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:omni_multitool.Features.WaterReminder"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="WaterReminder">


    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </Page.Resources>

    <Grid>

        <StackPanel Margin="30">

            <!--Utilities Section-->

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                    Style="{StaticResource IconStyle}">

                    <TextBlock
                FontFamily="{StaticResource MaterialSymbolsOutlined}"
                Text="&#xE869;"
                FontSize="22"
                FontWeight="Thin"
                Foreground="#FEFEFE"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"/>

                </Border>

                <StackPanel Grid.Column="1"
                Orientation="Horizontal"
                VerticalAlignment="Center"
                Margin="20,0,0,0">
                    <TextBlock
                    Text="Utilities"
                    Margin="0,4,0,0"
                    Style="{StaticResource SettingsSectionHeader}"/>

                    <TextBlock
                    Text=" / "
                    Margin="0,4,0,0"
                    Style="{StaticResource SettingsSectionHeader}"
                    Foreground="#666666"/>

                    <TextBlock
                    Text="Water Reminder"
                    Margin="0,4,0,0"
                    Style="{StaticResource SettingsSectionHeader}"/>

                </StackPanel>
            </Grid>

            <Border Height="1"
                Background="#444444"
                Margin="0,20,0,20"/>

            <StackPanel>


                <!--Water Reminder toggle-->

                <TextBlock
        Text="Water Reminder"
        FontSize="22"
        FontWeight="Medium"
        Foreground="#C94FF8"/>

                <Grid Margin="0,10,0,0">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>



                    <ToggleButton
            x:Name="WaterReminderToggle"
            Style="{StaticResource ToggleStyle}"
            Margin="10"
            Grid.Column="0"/>

                    <TextBlock
            Grid.Column="1"
            Foreground="#C8C8C8"
            FontSize="16"
            VerticalAlignment="Center">

                        <TextBlock.Style>
                            <Style TargetType="TextBlock">

                                <Setter Property="Text"
                            Value="Disabled"/>

                                <Style.Triggers>

                                    <DataTrigger
                            Binding="{Binding IsChecked, ElementName=WaterReminderToggle}"
                            Value="True">

                                        <Setter Property="Text"
                                    Value="Enabled"/>

                                    </DataTrigger>

                                </Style.Triggers>

                            </Style>
                        </TextBlock.Style>

                    </TextBlock>

                </Grid>

                <!--
                water reminder 
                conditonally 
                rendered settings
                -->

                <StackPanel Visibility="{Binding IsChecked, 
                    ElementName=WaterReminderToggle, 
                    Converter={StaticResource BooleanToVisibilityConverter}}">

                    <Border
                Height="1"
                Background="#444444"
                Margin="0,20,0,20"/>




                <!-- Interval reminder -->
                
                <Grid Margin="10,0,0,0">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="93.2"/>
                        <ColumnDefinition Width="54.687"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                            <Border
                Height="1"
                Background="#444444"
                Margin="0,20,0,20"/>
                            <!-- "Reminder me every" -->
                    <TextBlock
                Grid.Column="0"
                Text="Reminder me every"
                Foreground="#FEFEFE"
                FontSize="18"
                VerticalAlignment="Center" Grid.ColumnSpan="3" Margin="0,0,75,0"/>

                    <!-- Minute input -->
                    <Border
                Grid.Column="2"
                Width="55"
                Height="35"
                Margin="12,0,8,0"
                CornerRadius="8"
                Background="#FAF9F6"
                BorderBrush="#444444"
                BorderThickness="1">

                <TextBox
                Background="Transparent"
                Foreground="Black"
                Padding="5"
                BorderThickness="0"
                HorizontalContentAlignment="Center"
                VerticalContentAlignment="Center"
                Text="60"
                FontSize="18"/>

                    </Border>

                    <!-- "minutes" -->
                    <TextBlock
                Grid.Column="3"
                Text="minutes"
                Foreground="#FEFEFE"
                FontSize="18"
                VerticalAlignment="Center"/>

                </Grid>


                <!-- Reminder time range -->
                <Grid Margin="10,20,0,0">
                <TextBlock
                Grid.Column="0"
                Text="Remind me between 8:00 AM and 10:00 PM"
                Foreground="#FEFEFE"
                FontSize="18"
                VerticalAlignment="Center"/>
                </Grid>

                    <!--Reminder time range config postponed
                    Aug. 28, 2026
                    -->
                    
