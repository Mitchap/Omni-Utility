     <!--Reminder Sound Toggle-->    
                    
                    <Border
                Height="1"
                Background="#444444"
                Margin="0,20,0,20"/>

                    <!--Reminder Sound toggle-->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <ToggleButton
                    Style="{StaticResource ToggleStyle}"
                    IsChecked="True"
                    Margin="10"
                    Grid.Column="0"/>

                      <TextBlock Text="Play reminder sound"
                    FontSize="16"
                    Grid.Column="1"
                    Foreground="#C8C8C8"
                    VerticalAlignment="Center"/>
                    </Grid>


                </StackPanel>
            </StackPanel>
        </StackPanel>
    </Grid>
</Page>
