<Page x:Class="omni_multitool.Features.Favorites.EditFavoritesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:omni_multitool.Features.Favorites"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="EditFavoritesPage">

    <Grid>

        <StackPanel Margin="30">

            <!--Favorites Section-->

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                    Style="{StaticResource IconStyle}">

                    <TextBlock
                FontFamily="{StaticResource MaterialSymbolsOutlined}"
                Text="&#xE87D;"
                FontSize="22"
                FontWeight="Thin"
                Foreground="#FEFEFE"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"/>

                </Border>

                <StackPanel Grid.Column="1"
                Orientation="Horizontal"
                VerticalAlignment="Center"
                Margin="20,0,0,0">
                    <TextBlock
                    Text="Favorites"
                    Margin="0,4,0,0"
                    Style="{StaticResource SettingsSectionHeader}"/>

                    <TextBlock
                    Text=" / "
                    Margin="0,4,0,0"
                    Style="{StaticResource SettingsSectionHeader}"
                    Foreground="#666666"/>

                    <TextBlock
                    Text="Edit Favorites"
                    Margin="0,4,0,0"
                    Style="{StaticResource SettingsSectionHeader}"/>

                </StackPanel>
            </Grid>

            <Border Height="1"
                Background="#444444"
                Margin="0,20,0,20"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Utility Cards -->

                <UniformGrid Columns="3">

                    <!--
                    ============ auto clicker
                    -->


                    <!--<Button Style="{StaticResource UtilityCardStyle}"
            Margin="0,0,50,20">

                        <StackPanel HorizontalAlignment="Center"
                    VerticalAlignment="Center">

                            <TextBlock
                FontFamily="{StaticResource MaterialSymbolsOutlined}"
                Text="&#xF511;"
                FontSize="28"
                Foreground="#C94FF8"
                HorizontalAlignment="Center"/>

                            <TextBlock Text="Auto Clicker"
                       FontFamily="{StaticResource Jost}"
                       FontSize="18"
                       Foreground="#FEFEFE"
                       HorizontalAlignment="Center"
                       Margin="0,12,0,0"/>

                        </StackPanel>

                    </Button>-->

                    <!--
                    ============ auto keyboard
                    -->

                    <!--<Button Style="{StaticResource UtilityCardStyle}"
            Margin="0,0,50,20">

                        <StackPanel HorizontalAlignment="Center"
                    VerticalAlignment="Center">

                            <TextBlock
                FontFamily="{StaticResource MaterialSymbolsOutlined}"
                Text="&#xF028;"
                FontSize="28"
                Foreground="#C94FF8"
                HorizontalAlignment="Center"/>

                            <TextBlock Text="Auto Keyboard"
                       FontFamily="{StaticResource Jost}"
                       FontSize="18"
                       Foreground="#FEFEFE"
                       HorizontalAlignment="Center"
                       Margin="0,12,0,0"/>

                        </StackPanel>

                    </Button>-->

                    <!--
                    ============ color picker
                    -->

                    <Button Style="{StaticResource UtilityCardStyle}"
                    Margin="0,0,50,20">

                    
                        
                    <StackPanel 
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Width="190"
                    Height="110">

                    <CheckBox
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    Foreground="#C8C8C8"
                    Margin="0,-40,0,0"
                    Cursor="Hand" RenderTransformOrigin="3.456,-0.983"/>
                                 
                        
                        <TextBlock
                    FontFamily="{StaticResource MaterialSymbolsOutlined}"
                    Text="&#xE3B8;"
                    FontSize="28"
                    Foreground="#C94FF8"
                    HorizontalAlignment="Center"/>

                            <TextBlock Text="Color Picker"
                       FontFamily="{StaticResource Jost}"
                       FontSize="18"
                       Foreground="#FEFEFE"
                       HorizontalAlignment="Center"
                       Margin="0,12,0,0"/>

                        </StackPanel>

                    </Button>


                    <!--
                    ============ image converter
                    -->

                    <Button Style="{StaticResource UtilityCardStyle}"
            Margin="0,0,50,20">

                        <StackPanel 
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Width="190"
                    Height="110">

                            <CheckBox
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    Foreground="#C8C8C8"
                    Margin="0,-40,0,0"
                    Cursor="Hand" RenderTransformOrigin="3.456,-0.983"/>


                            <TextBlock
                FontFamily="{StaticResource MaterialSymbolsOutlined}"
                Text="&#xe3f4;"
                FontSize="28"
                Foreground="#C94FF8"
                HorizontalAlignment="Center"/>

                            <TextBlock Text="Image Converter"
                       FontFamily="{StaticResource Jost}"
                       FontSize="18"
                       Foreground="#FEFEFE"
                       HorizontalAlignment="Center"
                       Margin="0,12,0,0"/>

                        </StackPanel>

                    </Button>


                    <!--
                    ============ unit converter
                    -->

                    <Button Style="{StaticResource UtilityCardStyle}"
            Margin="0,0,50,20">

                        <StackPanel 
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Width="190"
                    Height="110">

                            <CheckBox
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    Foreground="#C8C8C8"
                    Margin="0,-40,0,0"
                    Cursor="Hand" RenderTransformOrigin="3.456,-0.983"/>


                            <TextBlock
                FontFamily="{StaticResource MaterialSymbolsOutlined}"
                Text="&#xf6af;"
                FontSize="28"
                Foreground="#C94FF8"
                HorizontalAlignment="Center"/>

                            <TextBlock Text="Unit Converter"
                       FontFamily="{StaticResource Jost}"
                       FontSize="18"
                       Foreground="#FEFEFE"
                       HorizontalAlignment="Center"
                       Margin="0,12,0,0"/>

                        </StackPanel>

                    </Button>


                    <!--
                    ============ water reminder
                    -->

                    <Button
                    Style="{StaticResource UtilityCardStyle}"
                    Margin="0,0,50,20">

                        <StackPanel 
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Width="190"
                    Height="110">

                            <CheckBox
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    Foreground="#C8C8C8"
                    Margin="0,-40,0,0"
                    Cursor="Hand" RenderTransformOrigin="3.456,-0.983"/>


                            <TextBlock
            FontFamily="{StaticResource MaterialSymbolsOutlined}"
            Text="&#xe798;"
            FontSize="28"
            Foreground="#C94FF8"
            HorizontalAlignment="Center"/>

                            <TextBlock
            Text="Water Reminder"
            FontFamily="{StaticResource Jost}"
            FontSize="18"
            Foreground="#FEFEFE"
            HorizontalAlignment="Center"
            Margin="0,12,0,0"/>

                        </StackPanel>

                    </Button>
                </UniformGrid>


            </Grid>


        </StackPanel>
    </Grid>
</Page>
