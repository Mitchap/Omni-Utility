<Window x:Class="omni_multitool.Pages.CloseConfirmWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:omni_multitool.Pages"
        xmlns:helpers="clr-namespace:omni_multitool.Helpers"
        helpers:DraggableWindow.IsDraggable="True"
        Title="CloseConfirmWindow"
        Height="450" Width="700"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="CenterOwner">
    <!--Background="#1B1D2E"-->
    <Border Background="#1B1D2E"
            CornerRadius="20"
            BorderBrush="#6A088F"
            BorderThickness="1">
        <Grid>

            <Grid.RowDefinitions>
                <RowDefinition Height="60"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>


            <!--Header-->
            <Border Grid.Row="0"
        Grid.Column="0"
        Grid.ColumnSpan="2"
        Background="#232539"
        CornerRadius="20,20,0,0">
                <Grid>

                    <!-- Branding -->
                    <StackPanel Orientation="Horizontal"
                HorizontalAlignment="Left"
                Margin="20,0,0,0">

                        <TextBlock Text="Ω "
                   FontFamily="{StaticResource Kodchasan}"
                   FontSize="18"
                   FontWeight="Regular"
                   Foreground="#A611ED"
                   VerticalAlignment="Center"
                   />

                        <TextBlock Text="M N I"
                   FontFamily="{StaticResource Kodchasan}"
                   FontSize="18"
                   FontWeight="Regular"
                   VerticalAlignment="Center">

                            <TextBlock.Foreground>
                                <LinearGradientBrush StartPoint="0,0"
                                     EndPoint="1,0">

                                    <GradientStop Color="#A611ED"
                                  Offset="0"/>

                                    <GradientStop Color="#D9A9F5"
                                  Offset="0.90"/>

                                    <GradientStop Color="#D2D2D2"
                                  Offset="1"/>

                                </LinearGradientBrush>
                            </TextBlock.Foreground>

                        </TextBlock>

                    </StackPanel>


                    <!-- Window controls -->
                    <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Margin="0,0,20,0">


                        <Button  
                    Style="{StaticResource WindowControlButtonStyle}"
                            Click="ExitButton_Click">

                            <TextBlock
                     FontFamily="{StaticResource MaterialSymbolsOutlined}"
                     Text="&#xE5CD;"
                     FontSize="18"
                     Margin="0,0,0,0"/>

                        </Button>

                    </StackPanel>

                </Grid>

            </Border>

            <StackPanel
    HorizontalAlignment="Center"
    VerticalAlignment="Center"
    Grid.Row="1"
    Width="300">


                <TextBlock
            Text="Close OMNI?"
            FontSize="22"
            Foreground="#FEFEFE"
            HorizontalAlignment="Left"
            Margin="0,12,0,0"/>

                <TextBlock
            Text="How would you like to proceed?"
            FontSize="16"
            Foreground="#C8C8C8"
            FontWeight="Thin"
            HorizontalAlignment="Left"
            Margin="0,8,0,0"
            />

                <Button x:Name="ShutdownBtn"
             Content="Quit OMNI"
             Click="Shutdown_App_Click"
             Background="#ba251a"
             Foreground="#FEFEFE"
             BorderThickness="0"
             FontSize="14"
             Cursor="Hand" 
             Width="80"
             Height="25"
             Margin="0,20,0,0"
             HorizontalAlignment="Left">

                    <Button.Template>

                        <ControlTemplate TargetType="Button">

                            <Border Background="{TemplateBinding Background}"
                    CornerRadius="4">

                                <ContentPresenter
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"/>

                            </Border>

                        </ControlTemplate>

                    </Button.Template>
                </Button>

             <Button x:Name="MinimizeToTrayBtn"
             Content="Keep running in background"
             Click="MinimizeToTray_Click"
             Background="#5E28B6"
             Foreground="#FEFEFE"
             BorderThickness="0"
             FontSize="14"
             Cursor="Hand" 
             Width="185"
             Height="25"
             Margin="0,20,0,0"
             HorizontalAlignment="Left">

                    <Button.Template>

                        <ControlTemplate TargetType="Button">

                            <Border Background="{TemplateBinding Background}"
                    CornerRadius="4">

                                <ContentPresenter
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"/>

                            </Border>

                        </ControlTemplate>

                    </Button.Template>
                </Button>


                <Button x:Name="CancelBtn"
             Background="Transparent"
             Click="ExitButton_Click"
             HorizontalAlignment="Left"
             Foreground="#FEFEFE"
             BorderThickness="0"
             Cursor="Hand"
             Height="25"
             Margin="0,20,0,0">
                    
            <TextBlock
            Text="Cancel"
            FontSize="12"
            Foreground="#C8C8C8"
            FontWeight="Thin"
            TextDecorations="Baseline"/>
                    <Button.Template>
                        <ControlTemplate TargetType="Button">

                            <Border Background="{TemplateBinding Background}">

                                <ContentPresenter
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    />

                            </Border>

                        </ControlTemplate>
                    </Button.Template>
                </Button>

            </StackPanel>


        </Grid>

        

    </Border>
</Window>
