<Window x:Class="omni_multitool.Pages.WelcomePage"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:omni_multitool"
        xmlns:helpers="clr-namespace:omni_multitool.Helpers"
        mc:Ignorable="d"
        Title="MainWindow" 
        Width="1000"
        Height="600"
        MinWidth="1000"
        MinHeight="600"
        MaxWidth="1000"
        MaxHeight="600"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        helpers:DraggableWindow.IsDraggable="True"
        WindowStartupLocation="CenterScreen">
    <Border
            CornerRadius="20">
        <!-- Background -->
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0"
                             EndPoint="0,1">

                <GradientStop Color="#1B1B1B"
                          Offset="0"/>

                <GradientStop Color="#1B1B1B"
                          Offset="0.70"/>

                <GradientStop Color="#29202D"
                          Offset="0.90"/>

                <GradientStop Color="#431C52"
                          Offset="1"/>

            </LinearGradientBrush>
        </Border.Background>
        <Grid>




            <Grid Margin="0,20,0,0">
                <!-- Window controls -->
                <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Margin="0,0,20,0">

                    <Button Click="MinimizeButton_Click"
                    Style="{StaticResource WindowControlButtonStyle}"
                    Margin="0,0,15,0">

                        <TextBlock
                    FontFamily="{StaticResource MaterialSymbolsOutlined}"
                    Text="&#xE15B;"
                    FontSize="18"
                   
                    />

                    </Button>

                    <Button Click="ExitButton_Click"
                    Style="{StaticResource WindowControlButtonStyle}">

                        <TextBlock
                     FontFamily="{StaticResource MaterialSymbolsOutlined}"
                     Text="&#xE5CD;"
                     FontSize="18"
                     Margin="0,0,0,0"/>

                    </Button>

                </StackPanel>

            </Grid>

            <!-- Glass Cube -->
            <Image Source="/Assets/Images/GlassCube.png"
           Width="522"
           Height="404"
           HorizontalAlignment="Center"
           VerticalAlignment="Top"
           Margin="0,200,0,0"
           Opacity="0.8"/>

            <!-- Branding -->
            <StackPanel
    HorizontalAlignment="Center"
    VerticalAlignment="Top"
    Margin="0,180,0,0">

                <StackPanel Orientation="Horizontal"
                HorizontalAlignment="Center">

                    <TextBlock Text="Ω "
                   FontFamily="{StaticResource Kodchasan}"
                   FontSize="120"
                   FontWeight="Regular"
                   Foreground="#A611ED"
                   VerticalAlignment="Center"
                   />

                    <TextBlock Text="M N I"
                   FontFamily="{StaticResource Kodchasan}"
                   FontSize="120"
                   FontWeight="Regular"
                   VerticalAlignment="Center">

                        <TextBlock.Foreground>
                            <LinearGradientBrush StartPoint="0,0"
                                     EndPoint="1,0">

                                <GradientStop Color="#A611ED"
                                  Offset="0"/>

                                <GradientStop Color="#D9A9F5"
                                  Offset="0.90"/>

                                <GradientStop Color="#D2D2D2"
                                  Offset="1"/>

                            </LinearGradientBrush>
                        </TextBlock.Foreground>

                    </TextBlock>

                </StackPanel>

                <!-- Utility Suite -->
                <TextBlock Text="UTILITY SUITE"
               FontSize="20"
               FontWeight="Thin"
               Foreground="#C8C8C8"
               HorizontalAlignment="Center"
               Margin="0,-20,0,0"/>

            </StackPanel>


            <Grid Width="140"
      Height="40"
      Margin="0,320,0,0">

                <!-- Animated border / glow -->
                <Border x:Name="ContinueGlow"
                CornerRadius="10"
                Loaded="ContinueGlow_Loaded">

                    <Border.Background>
                        <LinearGradientBrush x:Name="ContinueGradient"
                             StartPoint="0,0"
                             EndPoint="1,0">

                            <GradientStop Color="#431C52" Offset="0"/>
                            <GradientStop Color="#6D2EFF" Offset="0.20"/>
                            <GradientStop Color="#A611ED" Offset="0.40"/>
                            <GradientStop Color="#C94FF8" Offset="0.55"/>
                            <GradientStop Color="#6D2EFF" Offset="0.75"/>
                            <GradientStop Color="#431C52" Offset="1"/>

                        </LinearGradientBrush>
                    </Border.Background>

                    <Border.Effect>
                        <DropShadowEffect Color="#A611ED"
                          BlurRadius="12"
                          ShadowDepth="0"
                          Opacity="0.6"/>
                    </Border.Effect>

                </Border>

                <!-- Actual button -->
                <Button x:Name="BtnContinue"
                Content="Continue"
                Margin="2"
                Background="#1B1B1B"
                Foreground="#FEFEFE"
                BorderThickness="0"
                FontFamily="{StaticResource Jost}"
                FontSize="14"
                Cursor="Hand"
                Click="BtnContinue_Click">

                    <Button.Template>

                        <ControlTemplate TargetType="Button">

                            <Border Background="{TemplateBinding Background}"
                    CornerRadius="8">

                                <ContentPresenter
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"/>

                            </Border>

                        </ControlTemplate>

                    </Button.Template>

                </Button>



            </Grid>


            <!-- Don't show again -->
            <CheckBox Content="Don't show this again"
              HorizontalAlignment="Center"
              VerticalAlignment="Bottom"
              Margin="0,0,0,65"
              Foreground="#C8C8C8"
              Cursor="Hand"/>

            <TextBlock Text="v0.1.0"
           FontFamily="{StaticResource Jost}"
           FontSize="11"
           Foreground="#80FEFEFE"
           HorizontalAlignment="Right"
           VerticalAlignment="Bottom"
           Margin="0,0,20,15"/>

        </Grid>
    </Border>
</Window>
