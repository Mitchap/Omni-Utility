<Page x:Class="omni_multitool.Pages.SettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:omni_multitool.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="SettingsPage">


    <Grid>

        <StackPanel Margin="30">

            <!--Settings Section-->
            
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                    Style="{StaticResource IconStyle}">

                 <TextBlock
                FontFamily="{StaticResource MaterialSymbolsOutlined}"
                Text="&#xE8B8;"
                FontSize="22"
                FontWeight="Thin"
                Foreground="#FEFEFE"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"/>

                </Border>

                <TextBlock Grid.Column="1"
               Text="Settings"
               Style="{StaticResource SettingsSectionHeader}"
               Margin="20,0,0,0"
               VerticalAlignment="Center"/>
            </Grid>

            <Border Height="1"
                Background="#444444"
                Margin="0,20,0,20"/>

            <!--Toggle Options-->
            
            <!--Start with windows-->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <ToggleButton
            Style="{StaticResource ToggleStyle}"
            Margin="10"
            Grid.Column="0"/>

            <TextBlock Text="Start with Windows"
               FontSize="16"
               Grid.Column="1"
               Foreground="#C8C8C8"
               VerticalAlignment="Center"/>
            </Grid>

            <!--Minimize to tray-->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <ToggleButton
            Style="{StaticResource ToggleStyle}"
            Margin="10"
            Grid.Column="0"/>

                <TextBlock Text="Minimize to tray"
               FontSize="16"
               Grid.Column="1"
               Foreground="#C8C8C8"
               VerticalAlignment="Center"/>
            </Grid>

            <!--Show welcome page on start-->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <ToggleButton
            Style="{StaticResource ToggleStyle}"
            Margin="10"
            Grid.Column="0"/>

                <TextBlock Text="Show Welcome page on start"
               FontSize="16"
               Grid.Column="1"
               Foreground="#C8C8C8"
               VerticalAlignment="Center"/>
            </Grid>

            
            <!--About Section-->
            
            <TextBlock Text="About Omni"
                   Style="{StaticResource SettingsSectionHeader}"
                   FontSize="16"
                   Margin="0,60,0,16"/>

            <Border Height="1"
                Background="#444444"/>

            <TextBlock Text="Version 0.1.0"
                   FontSize="14"
                   Foreground="#C8C8C8"
                   Margin="0,20,0,0"/>

            <TextBlock Text="Created by Mitch Barcenilla © 2026"
                   FontSize="14"
                   Foreground="#C8C8C8"
                   Margin="0,10,0,0"/>

            <StackPanel Orientation="Horizontal">

                <TextBlock
                FontFamily="{StaticResource MaterialDesignIcons}"
                Text="&#xF02A4;"
                FontSize="14"
                Foreground="#C8C8C8"
                Margin="0,10,10,0"/>

                <TextBlock
                FontFamily="{StaticResource MaterialDesignIcons}"
                Text="&#xF020C;"
                FontSize="14"
                Foreground="#C8C8C8"
                Margin="0,10,10,0"/>

                <TextBlock
                FontFamily="{StaticResource MaterialDesignIcons}"
                Text="&#xF01F0;"
                FontSize="14"
                Foreground="#C8C8C8"
                Margin="0,10,0,0"/>

            </StackPanel>
        </StackPanel>

    </Grid>
</Page>
