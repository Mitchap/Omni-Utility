<Page x:Class="omni_multitool.Pages.UtilitiesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:omni_multitool.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="UtilitiesPage">

    <Grid>

        <StackPanel Margin="30">

            <!--Utilities Section-->

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                    Style="{StaticResource IconStyle}">

                    <TextBlock
                FontFamily="{StaticResource MaterialSymbolsOutlined}"
                Text="&#xE869;"
                FontSize="22"
                FontWeight="Thin"
                Foreground="#FEFEFE"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"/>

                </Border>

                <TextBlock Grid.Column="1"
               Text="Utilities"
               Style="{StaticResource SettingsSectionHeader}"
               Margin="20,0,0,0"
               VerticalAlignment="Center"/>
            </Grid>

            <Border Height="1"
                Background="#444444"
                Margin="0,20,0,20"/>


            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Utility Cards -->

                <UniformGrid Columns="3">

                    <!--
                    ============ auto clicker
                    -->
                    
                    <Border Style="{StaticResource UtilityCardStyle}"
            Margin="0,0,50,20">

                        <StackPanel HorizontalAlignment="Center"
                    VerticalAlignment="Center">

                            <TextBlock
                FontFamily="{StaticResource MaterialSymbolsOutlined}"
                Text="&#xF511;"
                FontSize="28"
                Foreground="#C94FF8"
                HorizontalAlignment="Center"/>

                            <TextBlock Text="Auto Clicker"
                       FontFamily="{StaticResource Jost}"
                       FontSize="18"
                       Foreground="#FEFEFE"
                       HorizontalAlignment="Center"
                       Margin="0,12,0,0"/>

                        </StackPanel>

                    </Border>

                    <!--
                    ============ auto keyboard
                    -->
                    
                    <Border Style="{StaticResource UtilityCardStyle}"
            Margin="0,0,50,20">

                        <StackPanel HorizontalAlignment="Center"
                    VerticalAlignment="Center">

                            <TextBlock
                FontFamily="{StaticResource MaterialSymbolsOutlined}"
                Text="&#xF028;"
                FontSize="28"
                Foreground="#C94FF8"
                HorizontalAlignment="Center"/>

                            <TextBlock Text="Auto Keyboard"
                       FontFamily="{StaticResource Jost}"
                       FontSize="18"
                       Foreground="#FEFEFE"
                       HorizontalAlignment="Center"
                       Margin="0,12,0,0"/>

                        </StackPanel>

                    </Border>

                    <!--
                    ============ color picker
                    -->
                    
                    <Border Style="{StaticResource UtilityCardStyle}"
            Margin="0,0,50,20">

                        <StackPanel HorizontalAlignment="Center"
                    VerticalAlignment="Center">

                            <TextBlock
                FontFamily="{StaticResource MaterialSymbolsOutlined}"
                Text="&#xE3B8;"
                FontSize="28"
                Foreground="#C94FF8"
                HorizontalAlignment="Center"/>

                            <TextBlock Text="Color Picker"
                       FontFamily="{StaticResource Jost}"
                       FontSize="18"
                       Foreground="#FEFEFE"
                       HorizontalAlignment="Center"
                       Margin="0,12,0,0"/>

                        </StackPanel>

                    </Border>


                    <!--
                    ============ image converter
                    -->

                    <Border Style="{StaticResource UtilityCardStyle}"
            Margin="0,0,50,20">

                        <StackPanel HorizontalAlignment="Center"
                    VerticalAlignment="Center">

                            <TextBlock
                FontFamily="{StaticResource MaterialSymbolsOutlined}"
                Text="&#xe3f4;"
                FontSize="28"
                Foreground="#C94FF8"
                HorizontalAlignment="Center"/>

                            <TextBlock Text="Image Converter"
                       FontFamily="{StaticResource Jost}"
                       FontSize="18"
                       Foreground="#FEFEFE"
                       HorizontalAlignment="Center"
                       Margin="0,12,0,0"/>

                        </StackPanel>

                    </Border>


                    <!--
                    ============ unit converter
                    -->

                    <Border Style="{StaticResource UtilityCardStyle}"
            Margin="0,0,50,20">

                        <StackPanel HorizontalAlignment="Center"
                    VerticalAlignment="Center">

                            <TextBlock
                FontFamily="{StaticResource MaterialSymbolsOutlined}"
                Text="&#xf6af;"
                FontSize="28"
                Foreground="#C94FF8"
                HorizontalAlignment="Center"/>

                            <TextBlock Text="Unit Converter"
                       FontFamily="{StaticResource Jost}"
                       FontSize="18"
                       Foreground="#FEFEFE"
                       HorizontalAlignment="Center"
                       Margin="0,12,0,0"/>

                        </StackPanel>

                    </Border>


                    <!--
                    ============ water reminder
                    -->

                    <Border Style="{StaticResource UtilityCardStyle}"
            Margin="0,0,50,20">

                        <StackPanel HorizontalAlignment="Center"
                    VerticalAlignment="Center">

                            <TextBlock
                FontFamily="{StaticResource MaterialSymbolsOutlined}"
                Text="&#xe798;"
                FontSize="28"
                Foreground="#C94FF8"
                HorizontalAlignment="Center"/>

                            <TextBlock Text="Water Reminder"
                       FontFamily="{StaticResource Jost}"
                       FontSize="18"
                       Foreground="#FEFEFE"
                       HorizontalAlignment="Center"
                       Margin="0,12,0,0"/>

                        </StackPanel>

                    </Border>
                </UniformGrid>
                
                
            </Grid>


        </StackPanel>
    </Grid>
</Page>
