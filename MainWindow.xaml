<Window x:Class="omni_multitool.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:omni_multitool"
        xmlns:helpers="clr-namespace:omni_multitool.Helpers"
        mc:Ignorable="d"
        Title="MainWindow" 
        MinWidth="900"
        MinHeight="600"
        Width="1000"
        Height="600"
        Background="#1B1D2E"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="145"/>
            <ColumnDefinition Width="*"/>

        </Grid.ColumnDefinitions>



        <!-- Sidebar -->
        <Border Grid.Column="0"
            Background="#232539">

            <StackPanel Width="auto"
                    Margin="0">

                <Button x:Name="BtnFavorites"
                    Click="BtnFavorites_Click"
                    Style="{StaticResource SidebarButtonStyle}"
                    HorizontalAlignment="Stretch"
                    helpers:SidebarNavigation.IsActive="True">


                    <Grid >
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="32"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
               Text="Favorites"
               VerticalAlignment="Center"/>

                        <TextBlock Grid.Column="1"
               FontFamily="{StaticResource MaterialSymbolsOutlined}"
               Text="&#xE87D;"
               FontSize="16"
               HorizontalAlignment="Center"
               VerticalAlignment="Center"/>
                    </Grid>

                </Button>
                
                <Button x:Name="BtnUtilities"
                    Click="BtnUtilities_Click"
                    Style="{StaticResource SidebarButtonStyle}"
                    FontFamily="{StaticResource Jost}"
                    HorizontalAlignment="Stretch">

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="32"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
               Text="Utilities"
               VerticalAlignment="Center"/>

                        <TextBlock Grid.Column="1"
               FontFamily="{StaticResource MaterialSymbolsOutlined}"
               Text="&#xE869;"
               FontSize="16"
               HorizontalAlignment="Center"
               VerticalAlignment="Center"/>
                    </Grid>

                </Button>
                <Button x:Name="BtnSettings"
                    Click="BtnSettings_Click"
                    Style="{StaticResource SidebarButtonStyle}"
                    HorizontalAlignment="Stretch">

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="32"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
               Text="Settings"
               VerticalAlignment="Center"/>

                        <TextBlock Grid.Column="1"
               FontFamily="{StaticResource MaterialSymbolsOutlined}"
               Text="&#xE8B8;"
               FontSize="16"
               HorizontalAlignment="Center"
               VerticalAlignment="Center"/>
                    </Grid>

                </Button>



            </StackPanel>
        </Border>
        <!-- Content Area -->
        <Frame x:Name="MainFrame"
           Grid.Column="1"
           NavigationUIVisibility="Hidden"/>
    </Grid>
</Window>
