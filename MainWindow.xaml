<Window x:Class="omni_multitool.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:omni_multitool"
        xmlns:helpers="clr-namespace:omni_multitool.Helpers"
        mc:Ignorable="d"
        Title="MainWindow" 
        Width="1000"
        Height="600"
        MinWidth="1000"
        MinHeight="600"
        MaxWidth="1000"
        MaxHeight="600"
        WindowStyle="None"
        Background="#1B1D2E"
        helpers:DraggableWindow.IsDraggable="True"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="175"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>


        <Border Grid.Row="0"
        Grid.Column="0"
        Grid.ColumnSpan="2"
        Background="#232539">
            <Grid>

                <!-- Branding -->
                <StackPanel Orientation="Horizontal"
                HorizontalAlignment="Left"
                Margin="20,0,0,0">

                    <TextBlock Text="Ω "
                   FontFamily="{StaticResource Kodchasan}"
                   FontSize="18"
                   FontWeight="Regular"
                   Foreground="#A611ED"
                   VerticalAlignment="Center"
                   />

                    <TextBlock Text="M N I"
                   FontFamily="{StaticResource Kodchasan}"
                   FontSize="18"
                   FontWeight="Regular"
                   VerticalAlignment="Center">

                        <TextBlock.Foreground>
                            <LinearGradientBrush StartPoint="0,0"
                                     EndPoint="1,0">

                                <GradientStop Color="#A611ED"
                                  Offset="0"/>

                                <GradientStop Color="#D9A9F5"
                                  Offset="0.90"/>

                                <GradientStop Color="#D2D2D2"
                                  Offset="1"/>

                            </LinearGradientBrush>
                        </TextBlock.Foreground>

                    </TextBlock>

                </StackPanel>


                <!-- Window controls -->
                <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Margin="0,0,20,0">

                    <Button Click="MinimizeButton_Click"
                    Style="{StaticResource WindowControlButtonStyle}"
                    Margin="0,0,15,0">

                        <TextBlock
                    FontFamily="{StaticResource MaterialSymbolsOutlined}"
                    Text="&#xE15B;"
                    FontSize="18"
                   
                    />

                    </Button>

                    <Button Click="ExitButton_Click"
                    Style="{StaticResource WindowControlButtonStyle}">

                        <TextBlock
                     FontFamily="{StaticResource MaterialSymbolsOutlined}"
                     Text="&#xE5CD;"
                     FontSize="18"
                     Margin="0,0,0,0"/>

                    </Button>

                </StackPanel>

            </Grid>

        </Border>
        <!-- Sidebar -->
        <Border Grid.Row="1"
        Grid.Column="0"
        Background="#272942">

            <StackPanel
                Margin="0,10,0,0">

                <!-- Favorites -->
                <Button x:Name="BtnFavorites"
                Click="BtnFavorites_Click"
                Style="{StaticResource SidebarButtonStyle}"
                HorizontalAlignment="Stretch"
                helpers:SidebarNavigation.IsActive="True">

                    <Grid>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="32"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                           Text="Favorites"
                           VerticalAlignment="Center"/>

                        <TextBlock Grid.Column="1"
                           FontFamily="{StaticResource MaterialSymbolsOutlined}"
                           Text="&#xE87D;"
                           FontSize="16"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>

                    </Grid>

                </Button>

                <!-- Utilities -->
                <Button x:Name="BtnUtilities"
                Click="BtnUtilities_Click"
                Style="{StaticResource SidebarButtonStyle}"
                HorizontalAlignment="Stretch">

                    <Grid>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="32"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                           Text="Utilities"
                           VerticalAlignment="Center"/>

                        <TextBlock Grid.Column="1"
                           FontFamily="{StaticResource MaterialSymbolsOutlined}"
                           Text="&#xE869;"
                           FontSize="16"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>

                    </Grid>

                </Button>

                <!-- Settings -->
                <Button x:Name="BtnSettings"
                Click="BtnSettings_Click"
                Style="{StaticResource SidebarButtonStyle}"
                HorizontalAlignment="Stretch">

                    <Grid>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="32"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                           Text="Settings"
                           VerticalAlignment="Center"/>

                        <TextBlock Grid.Column="1"
                           FontFamily="{StaticResource MaterialSymbolsOutlined}"
                           Text="&#xE8B8;"
                           FontSize="16"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>

                    </Grid>

                </Button>

            </StackPanel>

        </Border>
        <!-- Content Area -->
        <Frame x:Name="MainFrame"
       Grid.Row="1"
       Grid.Column="1"
       NavigationUIVisibility="Hidden"
       />
    </Grid>
</Window>
